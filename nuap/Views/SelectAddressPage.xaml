<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nuap.Views.SelectAddressPage"
             BindingContext="{Binding Main, Source={StaticResource Locator}}">
    <ContentPage.Content>
        <StackLayout
            BackgroundColor="White"
            BindingContext="{Binding SelectAddress}">
            <Image
                Margin="0,50,0,0"
                Source="confirmpayment"
                WidthRequest="200">
            </Image>
            <Label
                Text="Seleccionar dirección"
                Padding="0,15,0,0"
                TextColor="#0274bc" 
                FontFamily="Poppins-Bold"
                FontSize="25"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            </Label>
            <Label
                Text="Por favor confirma si deseas que enviemos tu pedido a esta dirección"
                Padding="20,10,20,0"
                TextColor="#494949" 
                FontFamily="Poppins-Bold"
                FontSize="18"
                HorizontalTextAlignment="Center"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="Center">
            </Label>
            <Label
                Text="{Binding Address}"
                Padding="0,10,0,0"
                TextColor="#6fcf97" 
                FontFamily="Poppins-Bold"
                FontSize="16"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            </Label>
            <Button
                Text="Confirmar"
                FontFamily="Poppins-Bold"
                TextTransform="None"
                BackgroundColor="#ffc33a"
                HeightRequest="50"
                TextColor="White"
                BorderRadius="12"
                HorizontalOptions="FillAndExpand"
                Margin="40,80,40,0"
                FontSize="15"
                Command="{Binding ConfirmCommand}"
                IsEnabled="{Binding IsEnabled, Mode=TwoWay}">
            </Button>
            <Button
                Text="Eliminar"
                FontFamily="Poppins-Bold"
                TextTransform="None"
                BackgroundColor="#FF4233"
                HeightRequest="50"
                TextColor="White"
                BorderRadius="12"
                HorizontalOptions="FillAndExpand"
                Margin="40,10,40,0"
                FontSize="15"
                Command="{Binding DeleteCommand}"
                IsEnabled="{Binding IsEnabled, Mode=TwoWay}">
            </Button>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>