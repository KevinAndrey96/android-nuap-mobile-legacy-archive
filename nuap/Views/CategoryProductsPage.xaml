<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="nuap.Views.CategoryProductsPage"
    BindingContext="{Binding Main, Source={StaticResource Locator}}"
    BackgroundImageSource="CategoriaProductos.png">
    <ContentPage.Content>
        <StackLayout
            BindingContext="{Binding CategoryProduct}"
            Padding="5,10,0,0">
            <StackLayout.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="iOS">5,30,0,0</On>
                </OnPlatform>
            </StackLayout.Padding>
            <StackLayout
                Orientation="Horizontal">
                <Image
                    WidthRequest="30"
                    Margin="5,10,0,0"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    Source="flecha">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ReturnCommand}"/>
                    </Image.GestureRecognizers>
                </Image>
                <StackLayout
                    Margin="5,10,20,0">
                    <Frame
                        BorderColor="#e2e2e2"
                        CornerRadius="20"
                        HasShadow="true"
                        Padding="5"
                        BackgroundColor="#f6f8f9">
                        <SearchBar
                            FontFamily="Poppins"
                            FontSize="15"
                            TextColor="#3a3a3a"
                            PlaceholderColor="#3a3a3a"
                            Placeholder="Busca tu producto"
                            Text="{Binding Filter, Mode=TwoWay}"
                            SearchCommand="{Binding SearchCommand}" InputTransparent="False">
                        </SearchBar>
                    </Frame>
                </StackLayout>
            </StackLayout>
            <ScrollView
                Margin="5,58,0,0">
                <StackLayout
                    Padding="5,0,0,0">
                    <StackLayout.Padding>
                        <OnPlatform x:TypeArguments="Thickness">
                            <On Platform="iOS">5,50,0,0</On>
                        </OnPlatform>
                    </StackLayout.Padding>
                    <Label
                        Text="{Binding CategoryName}"
                        Padding="20,10,0,0"
                        TextColor="#3a3a3a" 
                        FontFamily="Poppins-Bold"
                        FontSize="20"
                        VerticalOptions="Center">
                    </Label>
                    <ListView 
                        HeightRequest="{Binding ProductsCategoryCount}"
                        IsVisible="{Binding ProductsCategoryVisibility}"
                        HasUnevenRows="true" 
                        IsPullToRefreshEnabled="true"
                        IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
                        ItemsSource="{Binding ProductsCategory}"
                        SeparatorVisibility="None"
                        RefreshCommand="{Binding RefreshCommand}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Frame
                                        CornerRadius="15"
                                        HasShadow="false"
                                        Margin="15,8,5,0">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ProductDetailCommand}"/>
                                        </Frame.GestureRecognizers>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout 
                                                Grid.Column="0"
                                                Padding="0,0,0,0"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center">
                                                <Image 
	                                                HeightRequest="100"
                                                    HorizontalOptions="CenterAndExpand"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Image.Source>
                                                        <UriImageSource 
                                                            Uri="{Binding Image}" 
			                                                CacheValidity="14" 
			                                                CachingEnabled="true"/>
                                                    </Image.Source>
                                                </Image>
                                            </StackLayout>
                                            <StackLayout 
                                                Padding="15,0,0,0"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                VerticalOptions="Center">
                                                <Label 
                                                    VerticalOptions="Center"
                                                    FontFamily="Poppins-Bold"
                                                    FontSize="15" 
                                                    Text="{Binding Name}"
                                                    TextColor="#3a3a3a">
                                                </Label>
                                                <StackLayout
                                                    Orientation="Horizontal">
                                                    <Label 
                                                        VerticalOptions="Center"
                                                        FontFamily="Poppins-Bold"
                                                        FontSize="17" 
                                                        Text="{Binding TotalPrice}"
                                                        TextColor="#0274bc">
                                                    </Label>
                                                </StackLayout>
                                            </StackLayout>
                                        </Grid>
                                    </Frame>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Label
                        IsVisible="{Binding SalesProductsVisibility}"
                        Text="Ofertas"
                        Padding="20,45,0,0"
                        TextColor="#3a3a3a" 
                        FontFamily="Poppins-Bold"
                        FontSize="18"
                        VerticalOptions="Center">
                    </Label>
                    <ListView 
                        HeightRequest="{Binding SalesProductsCount}"
                        IsVisible="{Binding SalesProductsVisibility}"
                        HasUnevenRows="true" 
                        IsPullToRefreshEnabled="true"
                        IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
                        ItemsSource="{Binding SalesProducts}"
                        SeparatorVisibility="None"
                        RefreshCommand="{Binding RefreshCommand}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Frame
                                        CornerRadius="15"
                                        HasShadow="false"
                                        Margin="15,8,5,0">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ProductDetailCommand}"/>
                                        </Frame.GestureRecognizers>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout 
                                                Grid.Column="0"
                                                Padding="0,0,0,0"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center">
                                                <Image 
	                                                HeightRequest="100"
                                                    HorizontalOptions="CenterAndExpand"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Image.Source>
                                                        <UriImageSource 
                                                            Uri="{Binding Image}" 
			                                                CacheValidity="14" 
			                                                CachingEnabled="true"/>
                                                    </Image.Source>
                                                </Image>
                                            </StackLayout>
                                            <StackLayout 
                                                Padding="15,0,0,0"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                VerticalOptions="Center">
                                                <Label 
                                                    VerticalOptions="Center"
                                                    FontFamily="Poppins-Bold"
                                                    FontSize="15" 
                                                    Text="{Binding Name}"
                                                    TextColor="#3a3a3a">
                                                </Label>
                                                <StackLayout
                                                    Orientation="Horizontal">
                                                    <Label 
                                                        VerticalOptions="Center"
                                                        FontFamily="Poppins-Bold"
                                                        TextDecorations="Strikethrough"
                                                        FontSize="14" 
                                                        Text="{Binding FormatSalePrice}"
                                                        TextColor="#c4c4c4">
                                                    </Label>
                                                    <Label 
                                                        VerticalOptions="Center"
                                                        FontFamily="Poppins-Bold"
                                                        FontSize="17" 
                                                        Text="{Binding TotalPrice}"
                                                        TextColor="#0274bc">
                                                    </Label>
                                                </StackLayout>
                                            </StackLayout>
                                        </Grid>
                                    </Frame>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Label
                        IsVisible="{Binding ProductsSubcategoryVisibility}"
                        Text="{Binding SubcategoryNameText}"
                        Padding="20,45,0,0"
                        TextColor="#3a3a3a" 
                        FontFamily="Poppins-Bold"
                        FontSize="18"
                        VerticalOptions="Center">
                    </Label>
                    <ListView 
                        HeightRequest="{Binding ProductsSubcategoryCount}"
                        IsVisible="{Binding ProductsSubcategoryVisibility}"
                        HasUnevenRows="true" 
                        IsPullToRefreshEnabled="true"
                        IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
                        ItemsSource="{Binding ProductsSubcategory}"
                        SeparatorVisibility="None"
                        RefreshCommand="{Binding RefreshCommand}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Frame
                                        CornerRadius="15"
                                        HasShadow="false"
                                        Margin="15,8,5,0">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ProductDetailCommand}"/>
                                        </Frame.GestureRecognizers>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout 
                                                Grid.Column="0"
                                                Padding="0,0,0,0"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center">
                                                <Image 
	                                                HeightRequest="100"
                                                    HorizontalOptions="CenterAndExpand"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Image.Source>
                                                        <UriImageSource 
                                                            Uri="{Binding Image}" 
			                                                CacheValidity="14" 
			                                                CachingEnabled="true"/>
                                                    </Image.Source>
                                                </Image>
                                            </StackLayout>
                                            <StackLayout 
                                                Padding="15,0,0,0"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                VerticalOptions="Center">
                                                <Label 
                                                    VerticalOptions="Center"
                                                    FontFamily="Poppins-Bold"
                                                    FontSize="15" 
                                                    Text="{Binding Name}"
                                                    TextColor="#3a3a3a">
                                                </Label>
                                                <StackLayout
                                                    Orientation="Horizontal">
                                                    <Label 
                                                        VerticalOptions="Center"
                                                        FontFamily="Poppins-Bold"
                                                        FontSize="17" 
                                                        Text="{Binding TotalPrice}"
                                                        TextColor="#0274bc">
                                                    </Label>
                                                </StackLayout>
                                            </StackLayout>
                                        </Grid>
                                    </Frame>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Label
                        IsVisible="{Binding ProductsSubcategoryOneVisibility}"
                        Text="{Binding SubcategoryNameOneText}"
                        Padding="20,45,0,0"
                        TextColor="#3a3a3a" 
                        FontFamily="Poppins-Bold"
                        FontSize="18"
                        VerticalOptions="Center">
                    </Label>
                    <ListView 
                        HeightRequest="{Binding ProductsSubcategoryOneCount}"
                        IsVisible="{Binding ProductsSubcategoryOneVisibility}"
                        HasUnevenRows="true" 
                        IsPullToRefreshEnabled="true"
                        IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
                        ItemsSource="{Binding ProductsSubcategoryOne}"
                        SeparatorVisibility="None"
                        RefreshCommand="{Binding RefreshCommand}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Frame
                                        CornerRadius="15"
                                        HasShadow="false"
                                        Margin="15,8,5,0">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ProductDetailCommand}"/>
                                        </Frame.GestureRecognizers>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout 
                                                Grid.Column="0"
                                                Padding="0,0,0,0"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center">
                                                <Image 
	                                                HeightRequest="100"
                                                    HorizontalOptions="CenterAndExpand"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Image.Source>
                                                        <UriImageSource 
                                                            Uri="{Binding Image}" 
			                                                CacheValidity="14" 
			                                                CachingEnabled="true"/>
                                                    </Image.Source>
                                                </Image>
                                            </StackLayout>
                                            <StackLayout 
                                                Padding="15,0,0,0"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                VerticalOptions="Center">
                                                <Label 
                                                    VerticalOptions="Center"
                                                    FontFamily="Poppins-Bold"
                                                    FontSize="15" 
                                                    Text="{Binding Name}"
                                                    TextColor="#3a3a3a">
                                                </Label>
                                                <StackLayout
                                                    Orientation="Horizontal">
                                                    <Label 
                                                        VerticalOptions="Center"
                                                        FontFamily="Poppins-Bold"
                                                        FontSize="17" 
                                                        Text="{Binding TotalPrice}"
                                                        TextColor="#0274bc">
                                                    </Label>
                                                </StackLayout>
                                            </StackLayout>
                                        </Grid>
                                    </Frame>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackLayout>
            </ScrollView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>