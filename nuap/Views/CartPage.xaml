<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nuap.Views.CartPage"
             BindingContext="{Binding Main, Source={StaticResource Locator}}">
    <ContentPage.Content>
        <StackLayout
            BackgroundColor="White"
            BindingContext="{Binding Cart}"
            Padding="5,0,0,0">
            <StackLayout>
                <Image
                    WidthRequest="30"
                    Margin="20,20,0,0"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    Source="flechaazul">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ReturnCommand}"/>
                    </Image.GestureRecognizers>
                </Image>
            </StackLayout>
            <Label
                Text="Carrito de compras"
                Padding="20,10,0,0"
                TextColor="#0274bc" 
                FontFamily="Poppins-Bold"
                FontSize="20"
                VerticalOptions="Center">
            </Label>
            <Label
                Text="Genial ya casi tienes tus productos"
                Padding="20,0,0,0"
                TextColor="#0274bc" 
                FontFamily="Poppins"
                FontSize="18"
                VerticalOptions="Center">
            </Label>
            <StackLayout
                Orientation="Horizontal">
                <Image
                    Margin="20,20,0,0"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    Source="ic_marcador_de_posicion">
                </Image>
                <Label
                    Text="{Binding AddressText}"
                    Margin="0,20,0,0"
                    TextColor="#3a3a3a" 
                    FontFamily="Poppins-Bold"
                    FontSize="15"
                    VerticalOptions="Center">
                </Label>
            </StackLayout>
            <Label
                Text="Lista de compras"
                Padding="20,10,0,0"
                TextColor="#0274bc" 
                FontFamily="Poppins-Bold"
                FontSize="20"
                VerticalOptions="Center">
            </Label>
            <ListView 
                BackgroundColor="White"
                HasUnevenRows="true" 
                IsPullToRefreshEnabled="true"
                IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
                ItemsSource="{Binding Cart}"
                SeparatorVisibility="None"
                RefreshCommand="{Binding RefreshCommand}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Frame
                                BorderColor="Transparent"
                                CornerRadius="20"
                                Margin="5,0,5,5">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddAndRemoveProductsCommand}"/>
                                </Frame.GestureRecognizers>
                                <StackLayout 
                                    Padding="5,0,0,0"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                    <StackLayout>
                                        <Label 
                                            VerticalOptions="Center"
                                            HorizontalOptions="Start"
                                            FontFamily="Poppins"
                                            FontSize="12" 
                                            Text="{Binding Name}"
                                            TextColor="#3a3a3a">
                                        </Label>
                                    </StackLayout>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackLayout 
                                            Grid.Column="0"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center">
                                            <StackLayout>
                                                <Image 
                                                    HeightRequest="60"
                                                    WidthRequest="60"
                                                    Source="{Binding Image}" 
                                                    HorizontalOptions="CenterAndExpand"
                                                    VerticalOptions="CenterAndExpand">
                                                </Image>
                                            </StackLayout>
                                        </StackLayout>
                                        <StackLayout 
                                            Grid.Column="1"
                                            Padding="0,0,0,0"
                                            HorizontalOptions="EndAndExpand"
                                            VerticalOptions="Center">
                                            <StackLayout
                                                Padding="20,0,0,0"
                                                Orientation="Horizontal">
                                                <Entry
                                                    IsReadOnly="true"
                                                    Text="{Binding Quantity, Mode=TwoWay}"
                                                    FontFamily="Poppins-Bold"
                                                    TextColor="#494949"
                                                    Keyboard="Numeric"
                                                    WidthRequest="60"
                                                    Placeholder="0"
                                                    FontSize="16"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="Center">
                                                </Entry>
                                                <Label
                                                    Text="und"
                                                    TextColor="#494949" 
                                                    FontFamily="Poppins-Bold"
                                                    FontSize="16"
                                                    VerticalOptions="Center">
                                                </Label>
                                            </StackLayout>
                                            <StackLayout
                                                Orientation="Horizontal"
                                                HorizontalOptions="EndAndExpand">
                                                <Label
                                                    Text="{Binding TotalPrice}"
                                                    Padding="0,2,0,0"
                                                    TextColor="#1b1464" 
                                                    FontFamily="Poppins-Bold"
                                                    FontSize="18"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                                </Label>
                                            </StackLayout>
                                        </StackLayout>
                                    </Grid>
                                </StackLayout>
                            </Frame>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackLayout
                Orientation="Horizontal">
                <Label
                    Text="Descuento:"
                    Padding="20,15,0,0"
                    TextColor="#2c3d55" 
                    FontFamily="Poppins"
                    FontSize="16"
                    VerticalOptions="Center">
                </Label>
                <Label
                    Text="{Binding Discount}"
                    Padding="0,15,0,0"
                    TextColor="#2c3d55" 
                    FontFamily="Poppins"
                    FontSize="16"
                    VerticalOptions="Center">
                </Label>
            </StackLayout>
            <StackLayout
                Orientation="Horizontal">
                <Label
                    Text="Envio:"
                    Padding="20,5,0,0"
                    TextColor="#2c3d55" 
                    FontFamily="Poppins"
                    FontSize="16"
                    VerticalOptions="Center">
                </Label>
                <Label
                    Text="{Binding Delivery}"
                    Padding="0,5,0,0"
                    TextColor="#2c3d55" 
                    FontFamily="Poppins"
                    FontSize="16"
                    VerticalOptions="Center">
                </Label>
            </StackLayout>
            <StackLayout
                Orientation="Horizontal">
                <Label
                    Text="Total:"
                    Padding="20,0,0,0"
                    TextColor="#2c3d55" 
                    FontFamily="Poppins-Bold"
                    FontSize="20"
                    VerticalOptions="Center">
                </Label>
                <Label
                    Text="{Binding Total}"
                    Padding="0,14,0,15"
                    TextColor="#0274bc" 
                    FontFamily="Poppins-Bold"
                    FontSize="20"
                    VerticalOptions="CenterAndExpand">
                </Label>
                <Button
                    Margin="0,0,10,10"
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="EndAndExpand"
                    Text="PAGAR"
                    FontFamily="Poppins"
                    TextTransform="None"
                    BackgroundColor="#ffc33a"
                    HeightRequest="50"
                    TextColor="White"
                    BorderRadius="18"
                    Padding="0,15"
                    FontSize="15"
                    Command="{Binding ChoosePaymentMethodCommand}"
                    IsEnabled="{Binding IsEnabled, Mode=TwoWay}">
                </Button>
            </StackLayout>
            <StackLayout
                Orientation="Horizontal">
                <Button
                    Margin="0,0,0,10"
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="CenterAndExpand"
                    Text="Vaciar carrito"
                    FontFamily="Poppins"
                    TextTransform="None"
                    BackgroundColor="#c4c4c4"
                    HeightRequest="50"
                    TextColor="White"
                    BorderRadius="18"
                    FontSize="15"
                    Command="{Binding CartEmptyCommand}"
                    IsEnabled="{Binding IsEnabledProducts, Mode=TwoWay}">
                </Button>
                <Button
                    Margin="0,0,0,10"
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="CenterAndExpand"
                    Text="Agregar más productos"
                    FontFamily="Poppins"
                    TextTransform="None"
                    BackgroundColor="#fd8700"
                    HeightRequest="50"
                    TextColor="White"
                    BorderRadius="18"
                    FontSize="15"
                    Command="{Binding AddProductsCommand}"
                    IsEnabled="{Binding IsEnabledProducts, Mode=TwoWay}">
                </Button>
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>