<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nuap.Views.PaymentRequestPage"
             BindingContext="{Binding Main, Source={StaticResource Locator}}">
    <ContentPage.Content>
        <StackLayout
            BindingContext="{Binding PaymentRequest}"
            BackgroundColor="White"
            Padding="20,0,20,0">
            <StackLayout.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="iOS">20,25,0,0</On>
                </OnPlatform>
            </StackLayout.Padding>
            <StackLayout
                Padding="20,10,0,0">
                <Image
                    WidthRequest="30"
                    Margin="0,20,0,0"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    Source="flechaazul">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ReturnCommand}"/>
                    </Image.GestureRecognizers>
                </Image>
            </StackLayout>
            <StackLayout 
                    Padding="20,10,0,0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Orientation="Horizontal">
                <Label 
                    VerticalOptions="Center"
                    HorizontalOptions="StartAndExpand"
                    FontFamily="Poppins-Bold"
                    FontSize="20" 
                    Text="COMERCIO ID"
                    TextColor="#0274bc">
                </Label>
                <Label 
                    VerticalOptions="Center"
                    HorizontalOptions="StartAndExpand"
                    FontFamily="Poppins-Bold"
                    FontSize="20" 
                    Text="{Binding CommerceID}"
                    TextColor="#0274bc">
                </Label>
            </StackLayout>
            <Label
                Text="Saldo disponible"
                Padding="0,30,0,0"
                TextColor="#414b5a" 
                FontFamily="Poppins-Bold"
                FontSize="20"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            </Label>
            <Label
                Text="{Binding Balance}"
                Padding="0,10,0,0"
                TextColor="#6fcf97" 
                FontFamily="Poppins-Bold"
                FontSize="38"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            </Label>
            <Label
                Text="Estás viendo el valor total disponible para retiro de cuenta. No incluye cobros, comisiones, ajustes y retenciones las cuales podras ver reflejadas al momento de ser efectuado el pago a tu cuenta bancaria"
                Padding="50,5,50,0"
                TextColor="#494949" 
                FontFamily="Poppins"
                FontSize="15"
                HorizontalTextAlignment="Center"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="Center">
            </Label>
            <Label 
                Padding="0,20,0,0"
                VerticalOptions="Center"
                HorizontalOptions="CenterAndExpand"
                FontFamily="Poppins-Bold"
                FontSize="20" 
                Text="¿Cuanto deseas retirar?"
                TextColor="#0274bc">
            </Label>
            <StackLayout 
                Padding="20,30,0,0"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="Center"
                Orientation="Horizontal">
                <Label
                    Text="$"
                    Padding="0,10,0,0"
                    TextColor="#6fcf97" 
                    FontFamily="Poppins-Bold"
                    FontSize="38"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                </Label>
                <Entry
                    Margin="0,10,0,0"
                    VerticalOptions="Center"
                    HorizontalOptions="FillAndExpand"
                    Keyboard="Numeric"
                    FontFamily="Poppins-Bold"
                    HorizontalTextAlignment="Center"
                    FontSize="38"
                    TextColor="#494949"
                    Text="{Binding Value, Mode=TwoWay}">
                </Entry>
            </StackLayout>
            <Button
                Text="Realizar Solicitud"
                FontFamily="Poppins-Bold"
                TextTransform="None"
                BackgroundColor="#ffc33a"
                HeightRequest="55"
                TextColor="#414b5a"
                BorderRadius="12"
                Margin="90,70,70,0"
                FontSize="16"
                Command="{Binding RequestCommand}"
                IsEnabled="{Binding IsEnabled, Mode=TwoWay}">
            </Button>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>