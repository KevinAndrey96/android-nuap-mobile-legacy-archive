<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:googleMaps="clr-namespace:Xamarin.Forms.GoogleMaps;assembly=Xamarin.Forms.GoogleMaps"
    xmlns:bindings="clr-namespace:Xamarin.Forms.GoogleMaps.Bindings;assembly=Xamarin.Forms.GoogleMaps.Bindings"
    xmlns:local="clr-namespace:nuap.ViewModels"
    x:Class="nuap.Views.CreateAddressPage"
    BackgroundImageSource="register.png">
    <ContentPage.BindingContext>
        <local:CreateAddressViewModel/>
    </ContentPage.BindingContext>
    <StackLayout
        Padding="15,25,20,0">
        <StackLayout>
            <Label
                Padding="10,0,10,0"
                Text="Agrega una dirección para que entreguemos tus pedidos"
                TextColor="White" 
                HorizontalTextAlignment="Center"
                FontSize="18"
                FontFamily="Poppins-Bold"
                FontAttributes="Bold"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            </Label>
            <Label
                Text="Selecciona la ubicación en el mapa"
                Padding="15,55,0,0"
                TextColor="#3a3a3a" 
                FontFamily="Poppins-Bold"
                FontSize="16"
                VerticalOptions="Center">
            </Label>
            <googleMaps:Map  
                HeightRequest="200"
                InitialCameraUpdate="4.725800, -74.050556, 12, 0, 0">
                <googleMaps:Map.Behaviors>
                    <bindings:BindingPinsBehavior Value="{Binding PinList}"/>
                    <bindings:MapClickedToCommandBehavior Command="{Binding MapClickedCommand}"/>
                </googleMaps:Map.Behaviors>
            </googleMaps:Map>
        </StackLayout>
        <ScrollView>
            <StackLayout>
                <Label
                    Text="Dirección:"
                    FontFamily="Poppins-Bold"
                    TextColor="#3a3a3a"
                    FontSize="16"
                    VerticalOptions="Center">
                </Label>
                <StackLayout
                    Orientation="Horizontal">
                    <Entry
                        FontFamily="Poppins"
                        HorizontalOptions="FillAndExpand" 
                        FontSize="16"
                        TextColor="#3a3a3a"
                        Text="{Binding Address, Mode=TwoWay}">
                    </Entry>
                </StackLayout>
                <Label
                    Text="Ciudad:"
                    FontFamily="Poppins-Bold"
                    TextColor="#3a3a3a"
                    FontSize="16"
                    VerticalOptions="Center">
                </Label>
                <StackLayout
                    Orientation="Horizontal">
                    <Entry
                        FontFamily="Poppins"
                        HorizontalOptions="FillAndExpand" 
                        FontSize="16"
                        TextColor="#3a3a3a"
                        Text="{Binding City, Mode=TwoWay}">
                    </Entry>
                </StackLayout>
                <Label
                    Text="Localidad:"
                    FontFamily="Poppins-Bold"
                    TextColor="#3a3a3a"
                    FontSize="16"
                    VerticalOptions="Center">
                </Label>
                <StackLayout
                    Orientation="Horizontal">
                    <Entry
                        FontFamily="Poppins"
                        HorizontalOptions="FillAndExpand" 
                        FontSize="16"
                        TextColor="#3a3a3a"
                        Text="{Binding Location, Mode=TwoWay}">
                    </Entry>
                </StackLayout>
                <Label
                    Text="Barrio:"
                    FontFamily="Poppins-Bold"
                    TextColor="#3a3a3a"
                    FontSize="16"
                    VerticalOptions="Center">
                </Label>
                <StackLayout
                    Orientation="Horizontal">
                    <Entry
                        FontFamily="Poppins"
                        HorizontalOptions="FillAndExpand" 
                        FontSize="16"
                        TextColor="#3a3a3a"
                        Text="{Binding Neighborhood, Mode=TwoWay}">
                    </Entry>
                </StackLayout>
            </StackLayout>    
        </ScrollView>
        <StackLayout
            Padding="20,10,20,20">
            <Button
                Text="Crear nueva dirección"
                FontFamily="Poppins"
                TextTransform="None"
                BackgroundColor="#fd8700"
                HeightRequest="60"
                TextColor="White"
                BorderRadius="20"
                Padding="20,20,20,20"
                FontSize="17"
                Command="{Binding CreateAddressCommand}"
                IsEnabled="{Binding IsEnabled, Mode=TwoWay}">
            </Button>
        </StackLayout>
    </StackLayout>
</ContentPage>