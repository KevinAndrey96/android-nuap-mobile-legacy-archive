<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nuap.Views.PaymentConfirmPage"
             BindingContext="{Binding Main, Source={StaticResource Locator}}"
             BackgroundImageSource="solic.png">
    <ContentPage.Content>
        <StackLayout
            BindingContext="{Binding PaymentConfirm}">
            <Label
                Text="{Binding Value}"
                Padding="0,500,0,0"
                TextColor="#6fcf97" 
                FontFamily="Poppins-Bold"
                FontSize="38"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            </Label>
            <Label 
                Padding="0,80,0,0"
                VerticalOptions="Center"
                HorizontalOptions="CenterAndExpand"
                FontFamily="Poppins"
                FontSize="20" 
                Text="{Binding Date}"
                TextColor="#494949">
            </Label>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>