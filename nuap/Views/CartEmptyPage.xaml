<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nuap.Views.CartEmptyPage"
             BindingContext="{Binding Main, Source={StaticResource Locator}}">
    <ContentPage.Content>
        <StackLayout
            BackgroundColor="White"
            BindingContext="{Binding CartEmpty}">
            <StackLayout.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="iOS">0,22,0,0</On>
                </OnPlatform>
            </StackLayout.Padding>
            <StackLayout>
                <Image
                    WidthRequest="30"
                    Margin="20,20,0,20"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    Source="flechaazul">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ReturnCommand}"/>
                    </Image.GestureRecognizers>
                </Image>
            </StackLayout>
            <Image
                Margin="0,130,0,0"
                Source="emptycar"
                WidthRequest="300">
            </Image>
            <Label
                Text="Tu carro esta vacio"
                Padding="20,0,20,0"
                TextColor="#494949" 
                FontFamily="Poppins-Bold"
                FontSize="18"
                HorizontalTextAlignment="Center"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="Center">
            </Label>
            <Label
                Text="No ha agregado ningun articulo"
                Padding="20,5,20,0"
                TextColor="#494949" 
                FontFamily="Poppins-Bold"
                FontSize="18"
                HorizontalTextAlignment="Center"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="Center">
            </Label>
            <Button
                Text="Comenzar a comprar"
                FontFamily="Poppins"
                TextTransform="None"
                BackgroundColor="#ffc33a"
                HeightRequest="60"
                TextColor="#403e3a"
                BorderRadius="20"
                FontSize="20"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="EndAndExpand"
                Padding="40,0,40,0"
                Margin="20,0,20,80"
                Command="{Binding InitPageCommand}"
                IsEnabled="{Binding IsEnabled, Mode=TwoWay}">
            </Button>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>